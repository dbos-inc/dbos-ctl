# A PostgreSQL image whose DBOS system schema is already migrated, for the SDK
# test suites. The suites that use it point at one of the dbos_test_N databases
# and reset by deleting rows, so the DDL is paid once at build time instead of
# once per database per CI run.
#
# The schema is generated by `dbosctl sysdb migrate --print-migrations all` --
# see the test-images target in the Makefile -- rather than checked in, so an
# image cannot ship a migration set older than the tree it was built from. The
# generated script ends by recording the version in dbos.dbos_migrations, which
# is what makes an SDK skip migrating: every SDK gates on `current < latest`, so
# a database at or ahead of the SDK's own latest is left alone, and one behind
# gets only the tail applied.
ARG BASE_IMAGE=postgres:16
FROM ${BASE_IMAGE}

# PGDATA has to live outside every path the base image declares a VOLUME over,
# and "outside" is the whole point of the path below: 14 through 17 declare
# /var/lib/postgresql/data, but 18 declares /var/lib/postgresql, so anywhere
# under /var/lib/postgresql is inside the volume on 18 even though it looks
# outside it on 17.
#
# Being inside one is expensive rather than broken, which is what makes it worth
# a comment. Docker gives every container an anonymous volume for a declared
# path and seeds it from the image, so a cluster baked inside one is copied out
# in full on each start -- measured at 90.5MB and 1198ms against 0B and 627ms
# for the same image with PGDATA moved out. A suite taking a container per test
# pays that per test: a hundred gigabytes of copying across one run, which reads
# as a hung job rather than a slow one.
#
# The build itself does not care. BuildKit keeps writes made under a declared
# volume, so a wrong path here still produces a working image, and nothing fails
# until something counts how long starting one takes.
ENV PGDATA=/var/lib/dbos-prebuilt

# How many databases to bake. One per concurrent test worker: a suite that runs
# N ways in parallel needs N system databases, since a workflow table shared
# between workers is a cross-test data race rather than a speedup.
ARG DB_COUNT=4

# Which of the two generated PostgreSQL scripts to bake. The system schema
# normally carries triggers that fire pg_notify so a waiting application is woken
# rather than left polling, but that does not work behind a connection pooler in
# transaction mode -- the notification arrives on a session the application does
# not keep -- and nothing can detect that, so it is a deployment the SDKs support
# and therefore one their suites have to be able to test against. Hence two
# PostgreSQL images per version. CockroachDB has no LISTEN/NOTIFY on any release,
# so it has nothing to vary and gets one image.
#
# Both scripts end at the same migration version: a migration that renders empty
# still occupies its number, so an SDK reads a fully migrated database either way.
ARG SCHEMA_FILE=schema.postgres.sql
COPY ${SCHEMA_FILE} /tmp/schema.sql

# initdb refuses to run as root, so every step here goes through gosu, which the
# base image ships for its own entrypoint. Auth is trust: this image exists to be
# thrown away, and trust means a suite's connection string can carry whatever
# password it already has without this image having to agree on one.
#
# listen_addresses='' keeps the build-time server off the network -- it is only
# ever reached over the local socket -- so a build cannot collide with a
# PostgreSQL already running on the builder.
RUN set -eux; \
    install -d -o postgres -g postgres -m 0700 "$PGDATA"; \
    gosu postgres initdb -D "$PGDATA" --auth=trust --username=postgres; \
    gosu postgres pg_ctl -D "$PGDATA" -o "-c listen_addresses=''" -w start; \
    i=0; while [ "$i" -lt "$DB_COUNT" ]; do \
      gosu postgres createdb "dbos_test_$i"; \
      gosu postgres psql -q -v ON_ERROR_STOP=1 -d "dbos_test_$i" -f /tmp/schema.sql; \
      i=$((i+1)); \
    done; \
    gosu postgres pg_ctl -D "$PGDATA" -m fast -w stop; \
    rm -f /tmp/schema.sql

# No CMD or ENTRYPOINT override: the base entrypoint finds an initialised PGDATA,
# skips its own initdb, and starts the server, so this runs like the stock image
# -- POSTGRES_PASSWORD included, which it no longer requires but still accepts.
